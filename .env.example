# --- Kickio marketplace (READ-ONLY) -----------------------------------------
# Accepts only a credential for a role that cannot write - currently `anon`
# (the publishable key) or `kickio_content_reader`. Anything else is rejected at
# startup. See docs/unblocking-sold-this-week.md.
KICKIO_SUPABASE_URL=https://rlveellvebfzgyobceru.supabase.co
KICKIO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Content engine (the engine's own database) ------------------------------
ENGINE_SUPABASE_URL=https://dsbrvpzfniosjtaxzpxm.supabase.co
ENGINE_SUPABASE_SERVICE_KEY=sb_secret_...

# --- Copy generation ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Scheduling --------------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <value>" on cron requests.
CRON_SECRET=

# --- Kickio public site (optional) ------------------------------------------
# Drafts link to https://kickio.com/marketplace/{product-slug} by default.
# Only set these if the site or its URL scheme moves.
KICKIO_SITE_URL=
KICKIO_PRODUCT_PATH=

# The engine's Supabase Auth account on Kickio. Optional: without both of these
# the engine connects as `anon` and the recipes needing sales or collector data
# report themselves blocked. See docs/kickio-service-account.md.
#
# Server-side only. Never NEXT_PUBLIC_.
KICKIO_ENGINE_EMAIL=
KICKIO_ENGINE_PASSWORD=
