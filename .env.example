# --- Kickio marketplace (READ-ONLY) -----------------------------------------
# Accepts only a credential for a role that cannot write - currently `anon`
# (the publishable key) or `kickio_content_reader`. Anything else is rejected at
# startup. See docs/unblocking-sold-this-week.md.
KICKIO_SUPABASE_URL=https://rlveellvebfzgyobceru.supabase.co
KICKIO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Content engine (the engine's own database) ------------------------------
ENGINE_SUPABASE_URL=https://dsbrvpzfniosjtaxzpxm.supabase.co
ENGINE_SUPABASE_SERVICE_KEY=sb_secret_...

# --- Copy generation ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Dashboard login ---------------------------------------------------------
# Signs the session cookie. REQUIRED: with this unset every page returns 503
# rather than letting anyone in, so set it before the first deploy of the login.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# --- Posting to X (optional) -------------------------------------------------
# All three must be set before the "Post to X now" button appears at all. With
# any of them missing the dashboard shows the manual flow only and nothing in
# the app will attempt an API call.
#
# X has been pay-per-use since February 2026: roughly $0.015 a post, and
# roughly $0.20 for a post containing a link. Every post this engine writes
# carries kickio.com and X auto-links bare domains, so budget the higher rate
# on all of them. That is also why posting is one tap per draft rather than
# automatic on approval.
#
# The app needs OAuth 2.0 USER context with `tweet.write`, `media.write`,
# `users.read` and `offline.access` - app-only auth cannot upload an image, and
# every post here is a card.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Seed only. X rotates the refresh token on every use, so after the first
# refresh the value in the `platform_tokens` table is the real one and this is
# ignored. If you ever see "invalid_grant", the account needs re-authorising
# and a fresh token seeded here against an empty table.
X_REFRESH_TOKEN=
# Only used to build the link shown after posting. Wrong or unset just means a
# less tidy URL, never a failed post.
X_HANDLE=

# --- Scheduling --------------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <value>" on cron requests.
CRON_SECRET=

# --- Kickio public site (optional) ------------------------------------------
# Drafts link to https://kickio.com/marketplace/{product-slug} by default.
# Only set these if the site or its URL scheme moves.
KICKIO_SITE_URL=
KICKIO_PRODUCT_PATH=

# The engine's Supabase Auth account on Kickio. Optional: without both of these
# the engine connects as `anon` and the recipes needing sales or collector data
# report themselves blocked. See docs/kickio-service-account.md.
#
# Server-side only. Never NEXT_PUBLIC_.
KICKIO_ENGINE_EMAIL=
KICKIO_ENGINE_PASSWORD=
